@page "/admin"
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using MyPharmacy.Client.Models.Pharmacists
@using MyPharmacy.Client.Services
@inject PharmacistService PharmacistService
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage
@attribute [Authorize(Roles = "Admin")]

<div class="container my-4 work-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Team access</span>
            <h2>Pharmacists</h2>
        </div>

    @if (userRole == "Admin")
    {
        <button class="btn btn-primary" @onclick="ShowCreateForm">
            <i class="fa-solid fa-user-plus"></i>
            Add Pharmacist
        </button>
    }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (isCreating && userRole == "Admin")
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-success text-white">Create Pharmacist</div>
            <div class="card-body">
                <EditForm Model="newPharmacist" OnValidSubmit="HandleCreate">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-2">
                        <label>Full Name</label>
                        <InputText class="form-control" @bind-Value="newPharmacist.FullName" />
                    </div>
                    <div class="mb-2">
                        <label>Email</label>
                        <InputText class="form-control" @bind-Value="newPharmacist.Email" />
                    </div>
                    <div class="mb-2">
                        <label>Password</label>
                        <InputText type="password" class="form-control" @bind-Value="newPharmacist.Password" placeholder="Min 6 chars" />
                    </div>
                    <div class="mb-2">
                        <label>Address</label>
                        <InputText class="form-control" @bind-Value="newPharmacist.Address" />
                    </div>
                    <div class="mb-2">
                        <label>Phone</label>
                        <InputText class="form-control" @bind-Value="newPharmacist.Phone" />
                    </div>
                    <div class="mb-2">
                        <label>Role</label>
                        <InputSelect class="form-select" @bind-Value="newPharmacist.Role">
                            <option value="Pharmacist">Pharmacist</option>
                            <option value="Admin">Admin</option>
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-success me-2">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                </EditForm>
            </div>
        </div>
    }
    else if (isEditing && userRole == "Admin")
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-warning text-dark">Edit Pharmacist</div>
            <div class="card-body">
                <EditForm Model="editingPharmacist" OnValidSubmit="HandleEdit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-2">
                        <label>Full Name</label>
                        <InputText class="form-control" @bind-Value="editingPharmacist.FullName" />
                    </div>
                    <div class="mb-2">
                        <label>Email</label>
                        <InputText class="form-control" @bind-Value="editingPharmacist.Email" />
                    </div>
                    <div class="mb-2">
                        <label>Address</label>
                        <InputText class="form-control" @bind-Value="editingPharmacist.Address" />
                    </div>
                    <div class="mb-2">
                        <label>Phone</label>
                        <InputText class="form-control" @bind-Value="editingPharmacist.Phone" />
                    </div>
                    <div class="mb-2">
                        <label>Role</label>
                        <InputSelect class="form-select" @bind-Value="editingPharmacist.Role">
                            <option value="Pharmacist">Pharmacist</option>
                            <option value="Admin">Admin</option>
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-warning me-2">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                </EditForm>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Role</th>
                    @if (userRole == "Admin")
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (pharmacists == null)
                {
                    <tr><td colspan="@(userRole == "Admin" ? 7 : 6)" class="text-center">Loading pharmacists...</td></tr>
                }
                else
                {
                    @foreach (var p in pharmacists)
                    {
                        <tr>
                            <td>@p.PharmacistID</td>
                            <td>@p.FullName</td>
                            <td>@p.Email</td>
                            <td>@p.Address</td>
                            <td>@p.Phone</td>
                            <td>@p.Role</td>
                            @if (userRole == "Admin")
                            {
                                <td>
                                    <button class="btn btn-sm btn-warning me-1" @onclick="() => StartEdit(p)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeletePharmacist(p.PharmacistID)">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<PharmacistReadDto>? pharmacists;
    private PharmacistCreateDto newPharmacist = new PharmacistCreateDto();
    private PharmacistReadDto editingPharmacist = new PharmacistReadDto();
    private bool isCreating = false;
    private bool isEditing = false;
    private string? errorMessage;

    private string userRole = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await GetUserRole();
        await LoadPharmacists();
    }

    private async Task GetUserRole()
    {
        var token = await LocalStorage.GetItemAsStringAsync("authToken");
        if (!string.IsNullOrEmpty(token))
        {
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwt = handler.ReadJwtToken(token);
            userRole = jwt.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
        }
    }

    private async Task LoadPharmacists()
    {
        try
        {
            pharmacists = await PharmacistService.GetAllAsync();
        }
        catch
        {
            errorMessage = "Error loading pharmacists. Are you authorized?";
        }
    }

    private void ShowCreateForm()
    {
        newPharmacist = new PharmacistCreateDto { Role = "Pharmacist" };
        isCreating = true;
        isEditing = false;
        errorMessage = null;
    }

    private void StartEdit(PharmacistReadDto p)
    {
        editingPharmacist = p;
        isEditing = true;
        isCreating = false;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        isCreating = false;
        isEditing = false;
        newPharmacist = new PharmacistCreateDto();
        editingPharmacist = new PharmacistReadDto();
        errorMessage = null;
    }

    private async Task HandleCreate()
    {
        var success = await PharmacistService.CreateAsync(newPharmacist);
        if (success)
        {
            await LoadPharmacists();
            CancelEdit();
        }
        else
            errorMessage = "Create failed. Check console/server logs.";
    }

    private async Task HandleEdit()
    {
        var dto = new PharmacistCreateDto
        {
            FullName = editingPharmacist.FullName,
            Email = editingPharmacist.Email,
            Address = editingPharmacist.Address,
            Phone = editingPharmacist.Phone,
            Role = editingPharmacist.Role ?? "Pharmacist",
        };

        var success = await PharmacistService.UpdateAsync(editingPharmacist.PharmacistID, dto);
        if (success)
        {
            await LoadPharmacists();
            CancelEdit();
        }
        else
            errorMessage = "Edit failed. Check console/server logs.";
    }

    private async Task DeletePharmacist(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete pharmacist {id}?");
        if (!confirmed) return;

        var success = await PharmacistService.DeleteAsync(id);
        if (success)
            await LoadPharmacists();
        else
            errorMessage = "Delete failed. Check console/server logs.";
    }
}
