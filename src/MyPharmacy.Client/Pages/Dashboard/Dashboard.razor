@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using MyPharmacy.Client.Models.Dashboard
@using MyPharmacy.Client.Services
@inject DashboardService DashboardService
@attribute [Authorize]

<div class="dashboard-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Pharmacy overview</span>
            <h2>Dashboard</h2>
        </div>
        <a class="btn btn-primary" href="/prescriptions/create">
            <i class="fa-solid fa-plus"></i>
            New prescription
        </a>
    </div>

    <section class="dashboard-showcase">
        <div class="showcase-copy">
            <span class="eyebrow">Today at the counter</span>
            <h3>Calm operations for careful pharmacy work.</h3>
            <p>Track patient visits, medication stock, and prescription flow from one focused workspace.</p>
            <div class="showcase-signals">
                <span><i class="fa-solid fa-shield-heart"></i> Verified access</span>
                <span><i class="fa-solid fa-boxes-stacked"></i> Stock-aware prescriptions</span>
                <span><i class="fa-solid fa-notes-medical"></i> Cleaner records</span>
            </div>
        </div>
        <div class="showcase-image">
            <img src="images/pharmacist-assisting-customer-pharmacy.jpg" alt="Pharmacist assisting a customer" />
        </div>
    </section>

    @if (stats == null)
    {
        <div class="loading-panel">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading dashboard...</p>
        </div>
    }
    else
    {
        <div class="row g-4 dashboard-grid">

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-card-patient">
                    <div class="stat-icon"><i class="fa-solid fa-bed-pulse"></i></div>
                    <div>
                        <p>Total Patients</p>
                        <h3>@stats.TotalPatients</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-card-meds">
                    <div class="stat-icon"><i class="fa-solid fa-capsules"></i></div>
                    <div>
                        <p>Total Medications</p>
                        <h3>@stats.TotalMedications</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-card-prescriptions">
                    <div class="stat-icon"><i class="fa-solid fa-file-prescription"></i></div>
                    <div>
                        <p>Total Prescriptions</p>
                        <h3>@stats.TotalPrescriptions</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <div class="stat-card stat-card-today">
                    <div class="stat-icon"><i class="fa-solid fa-calendar-check"></i></div>
                    <div>
                        <p>Today Prescriptions</p>
                        <h3>@stats.TodayPrescriptions</h3>
                    </div>
                </div>
            </div>

        </div>

        <div class="quick-actions-panel">
            <div>
                <span class="eyebrow">Quick actions</span>
                <h3>Keep the counter moving.</h3>
            </div>
            <div class="quick-actions">
                <a class="btn btn-primary" href="/prescriptions/create">
                    <i class="fa-solid fa-plus"></i>
                    Create Prescription
                    </a>
                <a class="btn btn-outline-secondary" href="/patients">
                    <i class="fa-solid fa-user-injured"></i>
                    Manage Patients
                    </a>
                <a class="btn btn-outline-secondary" href="/medications">
                    <i class="fa-solid fa-pills"></i>
                    Manage Medications
                    </a>
            </div>
        </div>
    }
</div>

@code {
    private DashboardStatsDto? stats;

    protected override async Task OnInitializedAsync()
    {
        stats = await DashboardService.GetStatsAsync();
    }
}
