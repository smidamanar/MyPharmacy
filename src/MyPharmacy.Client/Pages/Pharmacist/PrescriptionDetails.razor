@page "/prescriptions/details/{Id:int}"
@page "/prescriptions/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using MyPharmacy.Client.Services
@using MyPharmacy.Client.Models.Prescriptions
@inject PrescriptionService Service
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="page-heading">
    <div>
        <span class="eyebrow">Prescription record</span>
        <h2>Prescription Details</h2>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/prescriptions")'>
            <i class="fa-solid fa-arrow-left"></i>
            Back
        </button>
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo($"/prescriptions/edit/{Id}")'>
            <i class="fa-solid fa-pen"></i>
            Edit
        </button>
    </div>
</div>

@if (prescription == null)
{
    <div class="loading-panel">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Loading prescription...</p>
    </div>
}
else
{
    <div class="card p-4 record-card mb-4">
        <div class="record-avatar"><i class="fa-solid fa-file-prescription"></i></div>
        <div class="record-grid">
            <p><span>Patient</span><strong>@prescription.PatientName</strong></p>
            <p><span>Pharmacist</span><strong>@prescription.PharmacistName</strong></p>
            <p><span>Date</span><strong>@prescription.Date.ToShortDateString()</strong></p>
            <p><span>Notes</span><strong>@prescription.Notes</strong></p>
        </div>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Medication</th>
                <th>Quantity</th>
                <th>Unit Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in prescription.Items)
            {
                <tr>
                    <td>@i.MedicationName</td>
                    <td>@i.Quantity</td>
                    <td>@i.UnitPrice</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public int Id { get; set; }
    private PrescriptionReadDto? prescription;

    protected override async Task OnInitializedAsync()
    {
        prescription = await Service.GetByIdAsync(Id);
    }
}
