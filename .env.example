# Example only. Do not commit a real .env file.
# For local .NET development, prefer dotnet user-secrets as documented in README.md.

ConnectionStrings__DefaultConnection=Server=(localdb)\\MSSQLLocalDB;Database=MyPharmacyDb;Trusted_Connection=True;TrustServerCertificate=True;
JwtSettings__Key=replace-with-a-long-random-secret
JwtSettings__Issuer=MyPharmacy.Api
JwtSettings__Audience=MyPharmacy.Client
JwtSettings__ExpirationMinutes=120
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=ChangeThisAdminPassword123!
Cors__AllowedOrigins__0=https://localhost:7063
